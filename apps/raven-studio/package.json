{
  "name": "raven-studio",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env.staging -- nuxi build",
    "build-local": "nuxt build",
    "dev": "node ./scripts/schema-dev.mjs --command-base64=bnV4dCBkZXY=",
    "generate": "nuxt generate",
    "deploy": "pnpm -C ../schema run site:deploy -- $npm_package_name",
    "inst": "pnpm -C ../.. --filter $npm_package_name install",
    "preview": "nuxt preview",
    "start": "NITRO_HOST=0.0.0.0 NITRO_PORT=3123 node .output/server/index.mjs",
    "test:cashflow-ui": "tsx --test app/utils/cashflow-schedule-intents.test.ts",
    "test:statement-ui": "tsx --test app/utils/statement-source-state.test.ts",
    "test:financial-analytics-ui": "tsx --test app/utils/financial-analytics-surface.test.ts app/utils/financial-worldview-surface.test.ts",
    "test:account-ledger-ui": "tsx --test app/utils/account-ledger-evidence-surface.test.ts",
    "postinstall": "nuxt prepare",
    "add": "pnpm -C ../.. --filter raven-studio add",
    "remove": "pnpm -C ../.. --filter raven-studio remove"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.35.0",
    "@helios/protocol": "workspace:*",
    "@raven/domain": "workspace:*",
    "@raven/surreal": "workspace:*",
    "@nuxt/eslint": "1.13.0",
    "@nuxt/fonts": "0.13.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "nuxt": "^4.3.0",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "@trpc/server": "^11.4.4",
    "@trpc/client": "^11.4.4",
    "trpc-nuxt": "1.2.0",
    "superjson": "^2.2.2",
    "surrealdb": "^2.0.0-alpha.16",
    "typesense": "^1.8.2",
    "zod": "4.1.12",
    "iron-webcrypto": "^1.2.1",
    "pinia": "^2.3.1",
    "@pinia/nuxt": "^0.11.2",
    "dotenv-cli": "^10.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.88",
    "@unocss/core": "^66.6.0",
    "@unocss/nuxt": "^66.6.0",
    "@unocss/preset-attributify": "^66.6.0",
    "@unocss/preset-icons": "^66.6.0",
    "@unocss/preset-wind4": "^66.6.0",
    "@unocss/transformer-variant-group": "^66.6.0",
    "sass-embedded": "^1.97.3",
    "unocss": "^66.6.0",
    "vite": "^7.3.1",
    "dotenv-cli": "^10.0.0"
  }
}
