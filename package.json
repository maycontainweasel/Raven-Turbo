{
  "name": "mpd-wealth",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-stack.mjs",
    "dev:apps": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docs:data-atlas": "node scripts/generate-raven-data-atlas.mjs",
    "docs:data-atlas:check": "node scripts/generate-raven-data-atlas.mjs --check",
    "test:data-atlas": "node --test scripts/tests/raven-data-atlas.test.mjs",
    "test:dev-stack": "node --test scripts/tests/dev-stack.test.mjs",
    "test:transaction-purpose": "node --test scripts/tests/transaction-purpose-schema.test.mjs",
    "test:financial-analytics": "pnpm --filter @raven/domain test:financial-analytics && pnpm --filter @raven/surreal test:financial-analytics && pnpm --filter raven-mcp test:financial-analytics && pnpm --filter raven-studio test:financial-analytics-ui",
    "zip": "node scripts/share-repo-zip.mjs --profile ai-safe",
    "zip:ai-safe": "node scripts/share-repo-zip.mjs --profile ai-safe",
    "zip:developer-unsafe": "node scripts/share-repo-zip.mjs --profile developer-unsafe",
    "test:archive-safety": "node --test scripts/tests/ai-safe-archive-policy.test.mjs",
    "db:show": "sdb show .",
    "db:doctor": "sdb doctor .",
    "db:start": "sdb start .",
    "db:sql": "sdb sql .",
    "services:sync": "svc-reg sync .",
    "services:plan": "sm plan .",
    "services:doctor": "sm doctor .",
    "services:up": "node scripts/dev-stack.mjs",
    "services:up:raw": "sm up .",
    "services:db": "sm start surrealdb .",
    "services:raven": "sm start raven .",
    "services:typesense": "sm start typesense .",
    "typesense:up": "docker compose -f apps/raven/docker-compose.typesense.yml up typesense",
    "typesense:down": "docker compose -f apps/raven/docker-compose.typesense.yml down",
    "mcp:db:list": "sdb mcp list .",
    "mcp:db": "sdb mcp doctor . local",
    "mcp:db:static": "SDB_MCP_SKIP_CONNECT=1 sdb mcp doctor . local",
    "mcp:raven": "pnpm --dir apps/raven-mcp start:local",
    "historian:readiness": "pnpm --dir apps/raven-mcp check:historian-readiness",
    "historian:schema": "pnpm --dir apps/raven-mcp historian:schema"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
